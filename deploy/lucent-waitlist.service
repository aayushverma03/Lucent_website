[Unit]
Description=Lucent waitlist API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/lucent-backend
EnvironmentFile=/etc/lucent/waitlist.env
ExecStart=/opt/lucent-backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

# Hardening: read-only filesystem except the data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lucent
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
# Resource caps bound the blast radius of a memory/fork flood.
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
