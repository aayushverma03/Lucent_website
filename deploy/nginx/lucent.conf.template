# Lucent — static site served by Nginx on EC2.
# Installed to /etc/nginx/sites-available/lucent.conf by deploy/setup-server.sh
# (which substitutes __DOMAIN__). Certbot (--nginx) later appends the TLS
# server block and the HTTP->HTTPS redirect automatically.

# Edge rate-limit for the waitlist API (fixed-size shared memory; http context).
limit_req_zone $binary_remote_addr zone=lucent_api:10m rate=20r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    root /var/www/lucent;
    index index.html;

    # Serve the branded 404 page for unknown paths (try_files ... =404 triggers this).
    error_page 404 /404.html;

    # Security headers (apply to document responses).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Compress text assets; video/images are already compressed.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Keep HTML fresh so deploys show up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # CSS/JS change with deploys, so keep their cache short — new code shows
    # up for visitors within minutes (no version-bumping or hard-refresh needed).
    location ~* \.(?:css|js)$ {
        expires 5m;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        access_log off;
    }

    # Images, fonts, video rarely change — cache long.
    location ~* \.(?:woff2?|ttf|otf|eot|webp|png|jpe?g|gif|svg|ico|mp4|webm)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # Waitlist API — reverse-proxied to the local FastAPI service.
    location /api/ {
        limit_req zone=lucent_api burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Pretty URLs: /faq serves /faq.html; otherwise serve the file or 404.
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
