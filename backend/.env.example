# Copy to /etc/lucent/waitlist.env on the server (chmod 600) and fill in.
WAITLIST_DB_PATH=/var/lib/lucent/waitlist.db
WAITLIST_ADMIN_TOKEN=change-me-to-a-long-random-string

# AWS SES — an alert email is sent on every new signup.
# On EC2, attach an IAM role with ses:SendEmail instead of storing keys here.
# In the SES sandbox both addresses must be verified identities.
AWS_REGION=eu-west-1
WAITLIST_FROM_EMAIL=waitlist@lucent-ai.app
WAITLIST_ALERT_TO=you@lucent-ai.app

# Optional per-IP throttle.
WAITLIST_RATE_MAX=10
WAITLIST_RATE_WINDOW=60
